{
  "id": "opencode",
  "name": "OpenCode",
  "maker": "Open source, any model",
  "launchers": [
    {
      "name": "opencode",
      "held": {
        "by": "acp",
        "program": [
          "opencode",
          "acp"
        ]
      }
    }
  ],
  "commands": {
    "term": "Commands",
    "skill": "skill",
    "command": "command"
  },
  "with": {
    "home": ".local/state",
    "home_env": "XDG_STATE_HOME",
    "state": "opencode",
    "service": "service.json",
    "user": "opencode",
    "tools": {
      "shell": {
        "asks": "run `{command}`"
      }
    },
    "account_id": [
      {
        "place": {
          "kind": "sqlite",
          "file": ".local/share/opencode/opencode.db",
          "under": "user",
          "table": "credential",
          "column": "value",
          "provider_column": "integration_id"
        },
        "take": {
          "kind": "key",
          "path": [
            "key"
          ]
        }
      }
    ],
    "config_home": ".config",
    "config_env": "XDG_CONFIG_HOME",
    "config": "opencode",
    "project_folder": ".opencode",
    "settings": "opencode.json",
    "commands_folders": [
      "command",
      "commands"
    ]
  }
}
