{
  "id": "codex",
  "name": "Codex",
  "maker": "OpenAI",
  "first": "Open a new Codex session and trust airband’s hooks when it asks. Until you do, airband asks you on your phone only when Codex wants to run a command. Its other requests wait at Codex’s own keyboard.",
  "launchers": [
    {
      "name": "codex",
      "held": {
        "by": "acp",
        "program": [
          "npx",
          "-y",
          "@agentclientprotocol/codex-acp@2.8.0"
        ]
      }
    }
  ],
  "commands": {
    "term": "Skills",
    "skill": "skill",
    "command": "command"
  },
  "with": {
    "program": "codex",
    "home": ".codex",
    "home_env": "CODEX_HOME",
    "control_socket": "app-server-control/app-server-control.sock",
    "tools": {
      "Bash": {
        "asks": "run `{command}`"
      },
      "shell": {
        "asks": "run `{command}`"
      },
      "exec_command": {
        "asks": "run `{command}`"
      },
      "apply_patch": {
        "asks": [
          "{description}",
          "change files"
        ]
      }
    },
    "account_id": [
      {
        "place": {
          "kind": "file",
          "file": "auth.json",
          "under": "home"
        },
        "take": {
          "kind": "id",
          "jwt": [
            "tokens",
            "id_token"
          ],
          "path": [
            "https://api.openai.com/auth",
            "chatgpt_user_id"
          ],
          "org_path": [
            "https://api.openai.com/auth",
            "chatgpt_account_id"
          ]
        }
      },
      {
        "place": {
          "kind": "file",
          "file": "auth.json",
          "under": "home"
        },
        "take": {
          "kind": "key",
          "path": [
            "OPENAI_API_KEY"
          ],
          "provider": "openai"
        }
      },
      {
        "place": {
          "kind": "env",
          "name": "OPENAI_API_KEY"
        },
        "take": {
          "kind": "key",
          "provider": "openai"
        }
      }
    ],
    "deliver": [
      "{program}",
      "queue",
      "--thread",
      "{session}",
      "--resume",
      "--message",
      "{words}"
    ],
    "hooks_file": "hooks.json",
    "sessions": "sessions",
    "skills_folder": "skills",
    "agents_skills": ".agents/skills",
    "system_skills": ".system",
    "plugins_cache": "plugins/cache",
    "plugin_manifest": ".codex-plugin/plugin.json"
  }
}
