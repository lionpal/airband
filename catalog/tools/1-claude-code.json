{
  "id": "claude-code",
  "name": "Claude Code",
  "maker": "Anthropic",
  "launchers": [
    {
      "name": "claude-held",
      "argv": [
        "claude",
        "-p",
        "--input-format",
        "stream-json",
        "--output-format",
        "stream-json",
        "--verbose",
        "{options}"
      ],
      "models": {
        "fable": "fable",
        "opus": "opus",
        "sonnet": "sonnet",
        "haiku": "haiku"
      },
      "efforts": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "with_model": [
        "--model",
        "{model}"
      ],
      "with_effort": [
        "--effort",
        "{effort}"
      ],
      "held": {
        "by": "lines",
        "fresh": [
          "--session-id",
          "{id}"
        ],
        "resume": [
          "--resume",
          "{id}"
        ],
        "line": "{\"type\":\"user\",\"uuid\":{receipt},\"message\":{\"role\":\"user\",\"content\":{text}}}",
        "stop": "{\"type\":\"control_request\",\"request_id\":\"{id}\",\"request\":{\"subtype\":\"interrupt\"}}"
      }
    },
    {
      "name": "claude-code",
      "argv": [
        "tmux",
        "new-session",
        "-d",
        "-s",
        "{session}",
        "-c",
        "{cwd}",
        "claude",
        "{options}",
        "{task}"
      ],
      "models": {
        "fable": "fable",
        "opus": "opus",
        "sonnet": "sonnet",
        "haiku": "haiku"
      },
      "efforts": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "with_model": [
        "--model",
        "{model}"
      ],
      "with_effort": [
        "--effort",
        "{effort}"
      ]
    }
  ],
  "commands": {
    "term": "Skills",
    "skill": "skill",
    "command": "command"
  },
  "with": {
    "program": "claude",
    "accounts_api": "https://api.anthropic.com",
    "accounts_token": "https://platform.claude.com/v1/oauth/token",
    "model_names": {
      "claude-fable-5-2": "Fable 5.2",
      "claude-fable-5-1": "Fable 5.1",
      "claude-fable-5": "Fable 5",
      "claude-opus-5-5": "Opus 5.5",
      "claude-sonnet-5-5": "Sonnet 5.5",
      "claude-haiku-5-5": "Haiku 5.5",
      "claude-opus-4-7": "Opus 4.7",
      "claude-opus-4-6": "Opus 4.6",
      "claude-opus-4-5": "Opus 4.5",
      "claude-sonnet-4-6": "Sonnet 4.6",
      "claude-sonnet-4-5": "Sonnet 4.5",
      "claude-haiku-4-5": "Haiku 4.5",
      "claude-haiku-4-5-20251001": "Haiku 4.5"
    },
    "not_models": [
      "<synthetic>"
    ],
    "home": ".claude",
    "home_env": "CLAUDE_CONFIG_DIR",
    "account_file": ".claude.json",
    "account_seed": "{\"hasCompletedOnboarding\":true}",
    "account_email": "emailAddress",
    "sign_in": [
      "auth",
      "login"
    ],
    "keychain_service": "Claude Code-credentials",
    "login_key": "claudeAiOauth",
    "pid_env": "CLAUDE_PID",
    "inbox_env": "CLAUDE_CODE_MESSAGING_SOCKET",
    "inbox_scheme": "uds:",
    "inbox_token_env": "CLAUDE_CODE_MESSAGING_TOKEN",
    "entry_env": "CLAUDE_CODE_ENTRYPOINT",
    "headless_entry": "sdk-cli",
    "artifact_link": "claude-artifact",
    "oauth_client": "9d1c250a-e61b-44d9-88ed-5944d1962f5e",
    "oauth_beta": "oauth-2025-04-20",
    "beta_header": "anthropic-beta",
    "tools": {
      "TodoWrite": {
        "bookkeeping": true
      },
      "ToolSearch": {
        "bookkeeping": true
      },
      "TaskCreate": {
        "bookkeeping": true
      },
      "TaskUpdate": {
        "bookkeeping": true
      },
      "TaskList": {
        "bookkeeping": true
      },
      "ExitPlanMode": {
        "bookkeeping": true
      },
      "Read": {
        "doing": "Reading {file_path.file}",
        "asks": "read the file {file_path}",
        "touches": "{file_path}"
      },
      "Write": {
        "doing": "Editing {file_path|notebook_path.file}",
        "asks": "write the file {file_path}",
        "touches": "{file_path|notebook_path}"
      },
      "Edit": {
        "doing": "Editing {file_path|notebook_path.file}",
        "asks": "edit the file {file_path|notebook_path}",
        "touches": "{file_path|notebook_path}"
      },
      "MultiEdit": {
        "doing": "Editing {file_path|notebook_path.file}",
        "asks": "edit the file {file_path|notebook_path}",
        "touches": "{file_path|notebook_path}"
      },
      "NotebookEdit": {
        "doing": "Editing {file_path|notebook_path.file}",
        "asks": "edit the file {file_path|notebook_path}",
        "touches": "{file_path|notebook_path}"
      },
      "Grep": {
        "doing": "Searching for {pattern}"
      },
      "Glob": {
        "doing": "Looking for files"
      },
      "WebSearch": {
        "doing": "Searching the web for {query}",
        "asks": "search the web for \"{query}\""
      },
      "WebFetch": {
        "doing": [
          "Reading {url.site}",
          "Reading a web page"
        ],
        "asks": "fetch {url}"
      },
      "Bash": {
        "doing": "{command.line}",
        "asks": "run `{command}`",
        "touches": "{command.line}"
      },
      "Agent": {
        "role": "subagent"
      },
      "Task": {
        "role": "subagent"
      },
      "AskUserQuestion": {
        "role": "question"
      },
      "SendUserFile": {
        "role": "files"
      },
      "Artifact": {
        "role": "artifact"
      }
    },
    "server_tool": "__",
    "account_id": [
      {
        "place": {
          "kind": "file",
          "file": ".claude.json",
          "under": "user"
        },
        "take": {
          "kind": "id",
          "path": [
            "oauthAccount",
            "accountUuid"
          ],
          "org_path": [
            "oauthAccount",
            "organizationUuid"
          ]
        }
      },
      {
        "place": {
          "kind": "env",
          "name": "ANTHROPIC_API_KEY"
        },
        "take": {
          "kind": "key",
          "provider": "anthropic"
        }
      }
    ],
    "hooks_file": "settings.json",
    "sessions": "sessions",
    "projects": "projects",
    "subagent_transcript": "subagents/agent-{agent}.jsonl",
    "session_kind": "interactive",
    "session_entry": "cli",
    "commands_ask": [
      "-p",
      "--input-format",
      "stream-json",
      "--output-format",
      "stream-json",
      "--verbose",
      "--no-session-persistence",
      "--settings",
      "{\"disableAllHooks\":true}"
    ],
    "project_folder": ".claude",
    "skills_folder": "skills",
    "commands_folder": "commands",
    "plugins_installed": "plugins/installed_plugins.json",
    "plugin_manifest": ".claude-plugin/plugin.json"
  }
}
