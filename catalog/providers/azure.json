{
  "id": "azure",
  "name": "Microsoft Azure Speech",
  "key": {
    "name": "Azure key",
    "at": "portal.azure.com, a Speech resource, Keys and Endpoint",
    "check": {
      "method": "POST",
      "url": "https://{region}.api.cognitive.microsoft.com/sts/v1.0/issueToken",
      "auth": {
        "header": "ocp-apim-subscription-key"
      },
      "good": [
        200
      ],
      "wrong_key": [
        401
      ],
      "refused": [
        403,
        429
      ]
    }
  },
  "offers": [
    {
      "id": "neural-voices",
      "job": "voice",
      "by": {
        "interface": "azure",
        "with": {
          "url": "https://{region}.tts.speech.microsoft.com/cognitiveservices/v1",
          "language": "en-US"
        }
      },
      "label": "Microsoft Azure Speech",
      "preferred": true,
      "price": "About $0.81 per hour of speech",
      "priced": "2026-11-20",
      "voices": [
        {
          "id": "en-US-AvaMultilingualNeural",
          "name": "Ava",
          "about": "Expressive, American"
        },
        {
          "id": "en-US-EmmaMultilingualNeural",
          "name": "Emma",
          "about": "Cheerful, American"
        },
        {
          "id": "en-GB-SoniaNeural",
          "name": "Sonia",
          "about": "Friendly, British"
        },
        {
          "id": "en-GB-LibbyNeural",
          "name": "Libby",
          "about": "Positive, British"
        }
      ],
      "asks": [
        {
          "field": "region",
          "question": "Region",
          "usual": "eastus",
          "reach": true
        },
        {
          "field": "voice",
          "question": "Voice",
          "usual": "en-US-AvaMultilingualNeural"
        }
      ]
    },
    {
      "id": "speech-to-text",
      "job": "ears",
      "by": {
        "interface": "azure"
      },
      "label": "Microsoft Azure Speech",
      "preferred": true,
      "price": "About $1 per hour, 5 hours a month free",
      "priced": "2026-11-20",
      "asks": [
        {
          "field": "region",
          "question": "Region",
          "usual": "eastus",
          "reach": true
        },
        {
          "field": "language",
          "question": "Language",
          "usual": "en-US"
        }
      ]
    }
  ]
}
