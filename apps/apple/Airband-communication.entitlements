<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>aps-environment</key><string>$(AIRBAND_APS)</string>
  <key>com.apple.developer.usernotifications.communication</key><true/>
  <key>com.apple.developer.carplay-voice-based-conversation</key><true/>
  <key>keychain-access-groups</key><array><string>$(AppIdentifierPrefix)dev.airband.shared</string><string>$(AppIdentifierPrefix)dev.airband.private</string></array>
  <key>com.apple.security.application-groups</key><array><string>$(AIRBAND_APP_GROUP)</string></array>
</dict></plist>
