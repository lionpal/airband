# TLS for the relay's names, and nothing else. The names and the DNS zone come from /etc/airband/relay.env.
#
# The certificates are proved by a DNS record (Route 53, with this server's role), not by answering on the
# name, so one can be had for a name that does not point here yet. Only 443 is open: no redirect from 80.
{
	auto_https disable_redirects
	servers {
		protocols h1 h2
	}
}

{$RELAY_NAMES} {
	tls {
		dns route53 {
			hosted_zone_id {$ZONE_ID}
		}
		# give the record half a minute to reach every name server before asking for it to be checked
		propagation_delay 30s
	}
	# Caddy puts the caller's address in X-Forwarded-For and drops whatever the caller sent there, which is
	# what the relay's limits per address go by. A tower's pull is held open for 25 seconds: nothing here cuts it.
	reverse_proxy 127.0.0.1:{$PORT}
}
