#!/bin/bash
# Start the relay with its secrets, which are read from the parameter store each time and kept nowhere on this
# server: they go from there into the relay's environment and no further. Run by airband-relay.service.
set -euo pipefail
set -a; . /etc/airband/relay.env; set +a
eval "$(aws ssm get-parameters --region "$AWS_REGION" --with-decryption --output json \
  --names /airband/apns-key | python3 -c '
import json, shlex, sys
names = {"/airband/apns-key": "APNS_KEY"}
for p in json.load(sys.stdin)["Parameters"]:
    print("export %s=%s" % (names[p["Name"]], shlex.quote(p["Value"])))
')"
# This relay is open: anyone may pair through it, and the relay's own limits bound how much (new channels per
# address and in all, requests per channel and per address). It sees only sealed messages either way.
exec /opt/airband/airband-relay
